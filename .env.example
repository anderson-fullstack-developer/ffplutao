# ============================================================
# PLUTÃO SHOP — variáveis de ambiente (modelo, sem segredos)
# Copiar para .env e preencher.
# ATENÇÃO: variáveis com prefixo VITE_ vão para o browser.
# Nunca colocar segredos com prefixo VITE_.
# ============================================================

# --- App ---
APP_URL=http://localhost:8080
NODE_ENV=development

# --- Base de dados (Neon Postgres) ---
# Pooled (host com "-pooler"): usado pela app em runtime
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (host sem "-pooler"): usado para migrations
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Sessões / Auth ---
# 32+ bytes aleatórios. Gerar: openssl rand -base64 32
SESSION_SECRET=

# --- Encriptação das credenciais das contas (AES-256-GCM) ---
# Exatamente 32 bytes em base64. Gerar: openssl rand -base64 32
# Se esta chave se perder, as credenciais guardadas ficam irrecuperáveis.
CREDENTIALS_ENCRYPTION_KEY=
# Versão da chave (para rotação futura)
CREDENTIALS_KEY_VERSION=1

# --- Admin inicial (seed) ---
ADMIN_EMAIL=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Cloudinary (screenshots) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (futuro, ex.: Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Plutão Shop <no-reply@plutaoshop.com>"
